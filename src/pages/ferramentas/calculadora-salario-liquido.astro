---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { INSS_FAIXAS, IRRF_FAIXAS, DEDUCAO_DEPENDENTE, DESCONTO_SIMPLIFICADO, SALARIO_MINIMO, TETO_INSS, brl, salarioLiquido } from '../../lib/calc';

const ex = salarioLiquido(3000);
const ex6 = salarioLiquido(6000);
const faq = [
  {
    q: 'Quem ganha até R$ 5 mil paga Imposto de Renda em 2026?',
    a: 'Não. Desde janeiro de 2026, a Lei 15.270/2025 criou uma redução que zera o IR na fonte para quem recebe até R$ 5.000 por mês. Entre R$ 5.000,01 e R$ 7.350 o imposto diminui de forma gradual. O INSS continua sendo descontado normalmente.',
  },
  {
    q: 'Qual é o desconto do INSS em 2026?',
    a: `O INSS é progressivo: 7,5% até ${brl(SALARIO_MINIMO)}, 9% até R$ 2.902,84, 12% até R$ 4.354,27 e 14% até o teto de ${brl(TETO_INSS)}. Cada alíquota vale só para a parte do salário dentro da faixa, por isso o percentual efetivo é menor que a alíquota da última faixa.`,
  },
  {
    q: 'O FGTS é descontado do salário?',
    a: 'Não. O FGTS (8% do salário bruto) é pago pela empresa, além do salário, e depositado na sua conta do FGTS na Caixa. Ele aparece no holerite apenas como informação.',
  },
  {
    q: 'O que é o desconto simplificado do IR?',
    a: `É uma dedução fixa de ${brl(DESCONTO_SIMPLIFICADO)} por mês que substitui as deduções legais (INSS, dependentes e pensão). A empresa deve usar a opção que der menos imposto, e a calculadora faz essa comparação automaticamente.`,
  },
  {
    q: 'Quanto deduz cada dependente no Imposto de Renda?',
    a: `Cada dependente reduz a base de cálculo do IR em ${brl(DEDUCAO_DEPENDENTE)} por mês. Filhos até 21 anos (ou até 24 se estiverem na faculdade) e cônjuge sem renda são os casos mais comuns.`,
  },
];
---

<ToolLayout
  slug="calculadora-salario-liquido"
  title="Calculadora de salário líquido 2026 (INSS e IR atualizados)"
  description="Calcule seu salário líquido em 2026 com INSS, IRRF e a nova isenção do Imposto de Renda até R$ 5 mil. Grátis, rápido e sem cadastro."
  h1="Calculadora de salário líquido 2026"
  lead="Digite seu salário bruto e veja quanto você recebe de fato, com os descontos de INSS e Imposto de Renda pelas tabelas de 2026."
  faq={faq}
>
  <Fragment slot="calc">
    <form class="calc-form" id="f" novalidate>
      <label>Salário bruto (R$)
        <input name="salario" inputmode="decimal" placeholder="Ex.: 3.500,00" required autocomplete="off" />
      </label>
      <label>Número de dependentes
        <input name="dep" type="number" min="0" max="20" value="0" inputmode="numeric" />
      </label>
      <label>Pensão alimentícia (R$) <span class="hint">opcional</span>
        <input name="pensao" inputmode="decimal" placeholder="0,00" />
      </label>
      <label>Outros descontos (R$) <span class="hint">vale-transporte, plano de saúde etc.</span>
        <input name="outros" inputmode="decimal" placeholder="0,00" />
      </label>
      <button class="btn full" type="submit">Calcular salário líquido</button>
    </form>
    <div class="calc-result" id="r" hidden aria-live="polite"></div>
  </Fragment>

  <h2>Como calcular o salário líquido</h2>
  <p>
    O salário líquido é o bruto menos os descontos obrigatórios. Para a maioria dos trabalhadores CLT são dois: a contribuição
    ao INSS e o Imposto de Renda retido na fonte (IRRF). Depois entram descontos que dependem de você ou da empresa, como
    vale-transporte (até 6% do salário), plano de saúde, pensão alimentícia e faltas.
  </p>
  <ol>
    <li><strong>INSS:</strong> aplique a tabela progressiva faixa por faixa sobre o salário bruto.</li>
    <li><strong>Base do IR:</strong> salário bruto menos INSS, menos {brl(DEDUCAO_DEPENDENTE)} por dependente e menos pensão. Ou, se for melhor, bruto menos o desconto simplificado de {brl(DESCONTO_SIMPLIFICADO)}.</li>
    <li><strong>IR pela tabela:</strong> base × alíquota da faixa − parcela a deduzir.</li>
    <li><strong>Redução de 2026:</strong> quem tem rendimento bruto até R$ 5.000 fica isento; entre R$ 5.000,01 e R$ 7.350 o imposto cai pela fórmula R$ 978,62 − 0,133145 × salário.</li>
  </ol>

  <h3>Exemplo com salário de R$ 3.000</h3>
  <p>
    INSS de {brl(ex.inss)}, IR zerado pela nova isenção, salário líquido de <strong>{brl(ex.liquido)}</strong>. Com R$ 6.000, o
    INSS é {brl(ex6.inss)}, o IR fica em {brl(ex6.ir.imposto)} depois da redução de {brl(ex6.ir.reducao)}, e o líquido é
    <strong>{brl(ex6.liquido)}</strong>.
  </p>

  <h2>Tabela do INSS 2026</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Salário de contribuição</th><th>Alíquota</th></tr></thead>
      <tbody>
        {INSS_FAIXAS.map(([lim, a], i) => (
          <tr><td>{i === 0 ? `Até ${brl(lim)}` : `De ${brl(INSS_FAIXAS[i - 1][0] + 0.01)} até ${brl(lim)}`}</td><td>{(a * 100).toLocaleString('pt-BR')}%</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small muted">Portaria Interministerial MPS/MF nº 13/2026. Desconto máximo no teto: R$ 988,09.</p>

  <h2>Tabela do Imposto de Renda 2026 (mensal)</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Base de cálculo</th><th>Alíquota</th><th>Parcela a deduzir</th></tr></thead>
      <tbody>
        {IRRF_FAIXAS.map(([lim, a, d], i) => (
          <tr>
            <td>{i === 0 ? `Até ${brl(lim)}` : lim === Infinity ? `Acima de ${brl(IRRF_FAIXAS[i - 1][0])}` : `De ${brl(IRRF_FAIXAS[i - 1][0] + 0.01)} até ${brl(lim)}`}</td>
            <td>{a === 0 ? 'Isento' : `${(a * 100).toLocaleString('pt-BR')}%`}</td>
            <td>{d === 0 ? '-' : brl(d)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small muted">Lei 15.191/2025, com a redução da Lei 15.270/2025 aplicada depois do cálculo pela tabela.</p>
</ToolLayout>

<script>
  import { salarioLiquido, brl, pct } from '../../lib/calc';
  import { bind, hero, num, table } from '../../lib/ui';
  const f = document.getElementById('f') as HTMLFormElement;
  const r = document.getElementById('r') as HTMLElement;
  const el = (n: string) => f.elements.namedItem(n) as HTMLInputElement;
  bind(f, r, () => {
    const bruto = num(el('salario'));
    if (bruto <= 0) throw new Error('Digite o salário bruto para calcular.');
    const s = salarioLiquido(bruto, Math.max(0, Math.floor(num(el('dep')))), num(el('pensao')), num(el('outros')));
    const descontos = s.inss + s.ir.imposto + s.outros;
    return (
      hero('Seu salário líquido', s.liquido, `Descontos de ${brl(descontos)} (${pct(descontos / bruto, 1)} do bruto)`) +
      table([
        ['Salário bruto', s.bruto],
        [`INSS (${pct(s.inss / bruto, 2)} efetivo)`, s.inss, 'neg'],
        ['Imposto de Renda (IRRF)', s.ir.imposto, 'neg'],
        [`Base do IR (${s.ir.metodo === 'simplificado' ? 'desconto simplificado' : 'deduções legais'})`, s.ir.base, 'sub'],
        [`IR pela tabela (faixa de ${pct(s.ir.aliquota, 1)})`, s.ir.impostoTabela, 'sub'],
        ['Redução da Lei 15.270 (isenção até R$ 5 mil)', s.ir.reducao, 'sub'],
        ...(s.outros > 0 ? ([['Pensão e outros descontos', s.outros, 'neg']] as const) : []),
        ['Salário líquido', s.liquido, 'total'],
      ] as any) +
      `<p class="result-note">A empresa ainda deposita ${brl(s.fgts)} de FGTS por mês na sua conta da Caixa (não sai do seu salário).</p>`
    );
  });
</script>
