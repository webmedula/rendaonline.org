---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE, TOOLS } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const latest = posts.slice(0, 9);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <h1>IA, automação e ferramentas para ganhar dinheiro online</h1>
    <p>
      Tutoriais passo a passo, testados de verdade, para quem quer usar inteligência artificial e automação para trabalhar,
      criar conteúdo e montar uma renda na internet.
    </p>
    <a class="btn" href="/categoria/ferramentas/">Comece pelas ferramentas gratuitas</a>
  </section>

  <LeadMagnet />

  <section>
    <h2>Calculadoras grátis</h2>
    <ul class="tool-grid">
      {
        TOOLS.map((t) => (
          <li class="tool-card">
            <h3>
              <a href={`/ferramentas/${t.slug}/`}>{t.name}</a>
            </h3>
            <p>{t.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Últimos artigos</h2>
    {
      latest.length === 0 ? (
        <p class="muted">Os primeiros artigos chegam em breve.</p>
      ) : (
        <ul class="post-list">
          {latest.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      )
    }
  </section>

  <section>
    <h2>Por onde começar</h2>
    <ul class="post-list">
      {
        Object.entries(CATEGORIES).map(([slug, cat]) => (
          <li class="post-card">
            <h3>
              <a href={`/categoria/${slug}/`}>{cat.name}</a>
            </h3>
            <p>{cat.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
