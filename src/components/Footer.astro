---
import { CATEGORIES, SITE_TITLE, SOCIAL, TOOLS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div>
      <a href="/" class="footer-logo" aria-label={SITE_TITLE}>
        <picture>
        <source srcset="/logo-branco.png" media="(prefers-color-scheme: dark)" width="233" height="73" />
        <img src="/logo.png" alt={SITE_TITLE} loading="lazy" width="181" height="56" class="brand-logo" />
      </picture>
      </a>
      <p>Tutoriais práticos de IA, automação e ferramentas para trabalhar e ganhar dinheiro online.</p>
      <p>Um projeto da <a href="https://www.webmedula.com.br" rel="noopener">WebMedula</a>: sites, tráfego e automação.</p>
      <div class="social" aria-label="Redes sociais">
        <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Instagram do Renda Online">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={SOCIAL.facebook} target="_blank" rel="noopener" aria-label="Facebook do Renda Online">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
        </a>
      </div>
      <p>© {year} RendaOnline.org. Todos os direitos reservados.</p>
    </div>
    <div>
      <h3>Categorias</h3>
      <ul>
        {Object.entries(CATEGORIES).map(([slug, cat]) => <li><a href={`/categoria/${slug}/`}>{cat.name}</a></li>)}
        <li><a href="/trabalho-online/">Trabalho online</a></li>
      </ul>
    </div>
    <div>
      <h3>Calculadoras grátis</h3>
      <ul>
        {TOOLS.map((t) => <li><a href={`/ferramentas/${t.slug}/`}>{t.short}</a></li>)}
      </ul>
    </div>
    <div>
      <h3>Institucional</h3>
      <ul>
        <li><a href="/50-prompts-ia/">50 prompts de IA grátis</a></li>
        <li><a href="/servicos/">Serviços</a></li>
        <li><a href="/diagnostico-automacao/">Diagnóstico grátis para empresas</a></li>
        <li><a href="/delivery-sem-comissao/">Delivery sem comissão (WebTenda)</a></li>
        <li><a href="/sistemas-instalados/">Sistemas instalados para empresas</a></li>
        <li><a href="/mentoria/">Mentoria</a></li>
        <li><a href="/sobre/">Sobre</a></li>
        <li><a href="/contato/">Contato</a></li>
        <li><a href="/politica-de-privacidade/">Política de Privacidade</a></li>
        <li><a href="/termos-de-uso/">Termos de Uso</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </div>
</footer>
