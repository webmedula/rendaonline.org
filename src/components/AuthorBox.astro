---
import fs from 'node:fs';
import path from 'node:path';
import { AUTHOR_NAME, COMPANY_NAME, COMPANY_URL } from '../consts';
const hasPhoto = fs.existsSync(path.join(process.cwd(), 'public', 'autor.jpg'));
---

<aside class="author-box">
  {hasPhoto && <img src="/autor.jpg" alt={`Foto de ${AUTHOR_NAME}`} width="56" height="56" loading="lazy" />}
  <div>
    <strong>{AUTHOR_NAME}</strong>
    <p>
      Fundador da <a href={COMPANY_URL} rel="noopener">{COMPANY_NAME}</a>, que cria sites, tráfego pago e automações para empresas.
      No Renda Online, ensina o que aplica nos projetos de clientes: IA, servidores, automação e formas reais de ganhar dinheiro
      na internet. <a href="/sobre/">Saiba mais</a>.
    </p>
  </div>
</aside>
