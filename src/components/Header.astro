---
import { CATEGORIES } from '../consts';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="Renda Online, página inicial">
      <picture>
        <source srcset="/logo-branco.png" media="(prefers-color-scheme: dark)" width="233" height="73" />
        <img src="/logo.png" alt="Renda Online" fetchpriority="high" width="181" height="56" class="brand-logo" />
      </picture>
    </a>
    <nav class="nav" aria-label="Principal">
      {
        Object.entries(CATEGORIES).map(([slug, cat]) => (
          <a href={`/categoria/${slug}/`} aria-current={path.startsWith(`/categoria/${slug}/`) ? 'page' : undefined}>
            {cat.name}
          </a>
        ))
      }
      <a href="/ferramentas/" aria-current={path.startsWith('/ferramentas/') ? 'page' : undefined}>Calculadoras</a>
      <a href="/servicos/" class="nav-cta" aria-current={path === '/servicos/' ? 'page' : undefined}>Serviços</a>
      <a href="/mentoria/" aria-current={path === '/mentoria/' ? 'page' : undefined}>Mentoria</a>
      <a href="/sobre/" aria-current={path === '/sobre/' ? 'page' : undefined}>Sobre</a>
    </nav>
  </div>
</header>
