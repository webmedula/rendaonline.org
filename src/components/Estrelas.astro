---
interface Props { nota: number }
const { nota } = Astro.props;
const pct = (nota / 5) * 100;
---
<span class="stars" role="img" aria-label={`Nota ${nota.toLocaleString('pt-BR')} de 5`}>
  <span class="stars-bg">★★★★★</span><span class="stars-fg" style={`width:${pct}%`}>★★★★★</span>
</span>
<strong class="stars-num">{nota.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}</strong>
