---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AdSlot from '../components/AdSlot.astro';
import PostCard from '../components/PostCard.astro';
import ServiceCTA from '../components/ServiceCTA.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { AUTHOR_NAME, CATEGORIES, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, image, imageAlt, affiliate } = post.data;
const cat = CATEGORIES[category];
const url = `${SITE_URL}/${post.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? new URL(image, SITE_URL).toString() : `${SITE_URL}/og-default.png`,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Person', name: AUTHOR_NAME, url: `${SITE_URL}/sobre/` },
  publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE_URL}/categoria/${category}/` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} image={image} type="article" publishedTime={pubDate} modifiedTime={updatedDate} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </head>
  <body>
    <Header />
    <main class="container">
      <article class="prose">
        <nav class="meta small" aria-label="Você está em">
          <a href="/">Início</a> › <a href={`/categoria/${category}/`}>{cat.name}</a>
        </nav>
        <h1>{title}</h1>
        <p class="meta">
          <span>Por <a href="/sobre/">{AUTHOR_NAME}</a></span>
          <span>·</span>
          <span>Publicado em <FormattedDate date={pubDate} /></span>
          {
            updatedDate && (
              <>
                <span>·</span>
                <span>
                  Atualizado em <FormattedDate date={updatedDate} />
                </span>
              </>
            )
          }
        </p>
        {image && <img src={image} alt={imageAlt ?? title} width="1200" height="630" />}
        {
          affiliate && (
            <p class="notice">
              Este artigo tem links de afiliado. Se você comprar por eles, o site recebe uma comissão, sem custo extra para
              você. Só indicamos o que testamos.
            </p>
          )
        }
        <slot />
        <ServiceCTA category={category} tags={tags} />
        <AuthorBox />
      </article>
      {
        related.length > 0 && (
          <section class="prose">
            <h2>Leia também</h2>
            <ul class="post-list">
              {related.map((p) => (
                <PostCard post={p} />
              ))}
            </ul>
          </section>
        )
      }
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
